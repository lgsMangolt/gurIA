# Configuração local da gurIA. Copie para .env.local (Copy-Item .env.example .env.local).
# Não compartilhe o .env.local: ele pode conter credenciais.

# Banco local, o mesmo que `npm run db:up` sobe (PostgreSQL 16 no Docker, porta 5440).
# Os nomes "openmaic" (banco e usuário) vêm da versão anterior e continuam valendo.
DATABASE_URL=postgres://openmaic:openmaic-dev@127.0.0.1:5440/openmaic

# Instalação pessoal: um único dono local, sem login.
OWNER_SINGLE_USER=true
# Id do dono (padrão study-local, o dos dados já existentes).
# OWNER_SINGLE_USER_ID=study-local

# Modo pessoal de estudo: o servidor só atende a própria máquina.
# O nome antigo, OPENMAIC_STUDY_LOCAL, continua aceito; se os dois existirem, vale este.
GURIA_LOCAL=true

# --- Opcionais ---

# Porta do banco no Docker. Lida pelo `npm run db:up` no terminal, não por este arquivo:
#   $env:OPENMAIC_DB_PORT = '5442'; npm run db:up
# Se mudar, use a mesma porta no DATABASE_URL acima.
# OPENMAIC_DB_PORT=5440

# Senha do banco, só usada quando o volume ainda está vazio (primeira subida). Como a
# porta, é lida do terminal pelo `npm run db:up`. Use letras e números e repita no DATABASE_URL.
# PERSISTENCE_POSTGRES_PASSWORD=openmaic-dev

# Pasta de build do Next (a demo usa uma própria para não disputar com o app).
# GURIA_NEXT_DIST_DIR=.next

# Pasta de configuração do Codex, quando não é a padrão (~/.codex).
# CODEX_HOME=

# Permite importar páginas da rede local (por padrão, endereços locais são bloqueados).
# ALLOW_LOCAL_NETWORKS=false
