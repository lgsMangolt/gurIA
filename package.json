{
  "name": "guria",
  "version": "0.2.0",
  "private": true,
  "description": "gurIA: um espaço pessoal para estudar, praticar e acompanhar o que você aprende.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3033",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3033",
    "test": "vitest run --config vitest.study.config.ts",
    "typecheck": "tsc -p tsconfig.study.json --noEmit",
    "db:up": "docker compose -p guria-db -f docker-compose.db.yml up -d --wait postgres",
    "db:down": "docker compose -p guria-db -f docker-compose.db.yml stop postgres",
    "demo": "node scripts/readme-demo/up.mjs",
    "e2e:praticar": "node scripts/practice-e2e.mjs",
    "e2e:skills": "node scripts/skills-e2e.mjs",
    "e2e:cursos": "node scripts/courses-e2e.mjs",
    "screenshots": "node scripts/readme-demo/screenshots.mjs",
    "lint": "eslint",
    "format": "prettier --write app components lib tests scripts"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "next": "16.3.3",
    "pg": "8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "turndown": "7.2.4",
    "undici": "7.29.0",
    "yauzl": "3.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "20.19.37",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "prettier": "3.8.1",
    "sharp": "0.35.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
